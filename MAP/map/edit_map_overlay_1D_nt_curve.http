### UU3 SPDM - demo OVERLAY_1D template N-T Curve
#
# Mock tuong ung: N-T Curve
# - X: 回転数 [rpm]
# - T: トルク [Nm]
# - 4 series tuong ung 4 goc phan tu
#
# Chay tung request tu tren xuong duoi trong cung mot phien PyCharm.
# Chon Run with -> dev.
# Luu y: day la demo CO GHI DU LIEU.
# Neu chua co bien X/T phu hop, script tao map_variable master de tai su dung.
# Xoa MAP khong xoa cac map_variable master moi tao.

@healthBase = {{devBaseUrl}}
@apiBase = {{devApiBase}}
@scopeName = System_Control

### 1. Kiem tra server
# @name healthOverlayNT
# @no-log
GET {{healthBase}}/healthz
Accept: application/json

### 2. Dang nhap va tao ten map duy nhat
# @name loginOverlayNT
# @no-log
POST {{apiBase}}/user/login/
Content-Type: application/json
Accept: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

> {%
  client.test("Dang nhap thanh cong", function () {
    client.assert(response.status === 200, "Login khong tra HTTP 200");
    client.assert(Boolean(response.body?.access), "Response khong co access token");
  });

  if (response.body?.access) {
    const timestamp = new Date().toISOString().replace(/\D/g, "").slice(0, 14);
    client.global.set("access_token", response.body.access);
    client.global.set("refresh_token", response.body.refresh);
    client.global.set("ntMapName", `HTTP_DEMO_NT_CURVE_${timestamp}_001`);
  }
%}

### 3. Lay project dau tien
# @name selectProjectOverlayNT
# @no-log
GET {{apiBase}}/project/all-projects/
Authorization: Bearer {{access_token}}
Accept: application/json

> {%
  const project = response.body?.data?.[0];

  client.test("Tim thay project", function () {
    client.assert(Boolean(project), "Khong co project tai data[0]");
  });

  if (project) {
    client.global.set("projectId", String(project.project_id));
    client.global.set("projectName", project.project_name);
    client.global.set("phaseName", project.phase_name);
    client.global.set("destination", project.destination);
    client.global.set("drivetrain", project.drivetrain);
    client.global.set("bodyType", project.grade);
    client.global.set("powertrain", project.powertrain);
    client.global.set("lot", project.lot);
  }
%}

### 4. Chon mot SE parameter dang N/A hoac rong
# @name selectEmptyParameterOverlayNT
# @no-log
POST {{apiBase}}/se-list/v2/list-se-list-parameters-new/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

[
  [
    {
      "projects_key": ["{{projectId}}"],
      "project": "{{projectName}}",
      "destination": "{{destination}}",
      "drivetrain": "{{drivetrain}}",
      "body_type": "{{bodyType}}",
      "powertrain": "{{powertrain}}",
      "lot": "{{lot}}",
      "phase": "{{phaseName}}"
    }
  ]
]

> {%
  client.test("Doc danh sach SE thanh cong", function () {
    client.assert(response.status === 200, `API SE list tra HTTP ${response.status}`);
  });

  const groups = response.body?.projects?.[0]?.data ?? [];
  let selected = null;

  for (const group of groups) {
    for (const row of group.children ?? []) {
      for (const value of Object.values(row)) {
        if (!value || typeof value !== "object" || !("variation_id" in value)) continue;
        const current = value.z_request_median;
        const isEmpty = current === null
          || current === undefined
          || String(current).trim() === ""
          || ["N/A", "MAP"].includes(String(current).trim().toUpperCase());
        if (isEmpty) {
          selected = {
            projectId: row.project_id,
            parameterId: row.se_parameter_id,
            phaseId: row.phase_id,
            variationId: value.variation_id
          };
          break;
        }
      }
      if (selected) break;
    }
    if (selected) break;
  }

  client.test("Tim thay parameter an toan", function () {
    client.assert(Boolean(selected), "Khong co SE parameter N/A/rong trong project da chon");
  });

  if (selected) {
    client.global.set("targetProjectId", String(selected.projectId));
    client.global.set("targetParameterId", String(selected.parameterId));
    client.global.set("targetPhaseId", String(selected.phaseId));
    client.global.set("targetVariationId", String(selected.variationId));
  }
%}

### 5. Chon hoac chuan bi tao bien 回転数/rpm va トルク/Nm
# @name selectVariablesOverlayNT
# @no-log
POST {{apiBase}}/se-list/se-map/get-infomation/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{}

> {%
  const info = response.body?.data?.OVERLAY_1D;
  const xItems = info?.["X軸名_new"] ?? [];
  const tItems = info?.["T軸名_new"] ?? [];
  const x = xItems.find(item => item.variable_name === "回転数" && item.unit === "rpm");
  const t = tItems.find(item => item.variable_name === "トルク" && item.unit === "Nm");
  const addNew = {};

  client.test("Backend ho tro OVERLAY_1D", function () {
    client.assert(Boolean(info), "Response khong co OVERLAY_1D");
    client.assert(info?.max_points_per_series === 20, "max_points_per_series khong bang 20");
  });

  if (x) {
    client.global.set("ntXName", `${x.id}_${x.variable_name}_${x.unit}`);
  } else {
    client.global.set("ntXName", "");
    addNew.xname = {variable_name: "回転数", unit: "rpm"};
  }

  if (t) {
    client.global.set("ntTName", `${t.id}_${t.variable_name}_${t.unit}`);
  } else {
    client.global.set("ntTName", "");
    addNew.tname = {variable_name: "トルク", unit: "Nm"};
  }

  client.global.set("ntAddNewJson", JSON.stringify(addNew));
  client.log("N-T add_new: " + JSON.stringify(addNew));
%}

### 6. Tao N-T Curve bon goc phan tu
# @name createMapOverlayNT
# @no-log
POST {{apiBase}}/se-list/se-map/map-create/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{
  "chosen_id": 1,
  "mode": "OVERLAY_1D",
  "overlay_template": "N-T Curve",
  "df_edited": null,
  "df_editeds": null,
  "df_edited_z": null,
  "map_name": "N/A",
  "new_map_name": "{{ntMapName}}",
  "xname": "{{ntXName}}",
  "tname": "{{ntTName}}",
  "overlay_series": [
    {
      "series_key": "第1象限",
      "x_values": [0, 1000, 2000, 3000],
      "t_values": [0, 100, 150, 120]
    },
    {
      "series_key": "第2象限",
      "x_values": [-3000, -2000, -1000, 0],
      "t_values": [120, 150, 100, 0]
    },
    {
      "series_key": "第3象限",
      "x_values": [-3000, -2000, -1000, 0],
      "t_values": [-120, -150, -100, 0]
    },
    {
      "series_key": "第4象限",
      "x_values": [0, 1000, 2000, 3000],
      "t_values": [0, -100, -150, -120]
    }
  ],
  "project_id": "{{targetProjectId}}",
  "parameter_id": "{{targetParameterId}}",
  "phase_id": "{{targetPhaseId}}",
  "variation_id": "{{targetVariationId}}",
  "study_id": null,
  "scope_name": "{{scopeName}}",
  "add_new": {{ntAddNewJson}}
}

> {%
  client.test("Tao N-T Curve thanh cong", function () {
    client.assert(response.status === 200, "Create khong tra HTTP 200");
    client.assert(response.body?.status === "success", response.body?.message ?? "Create that bai");
  });
%}

### 7. Doc va doi chieu N-T Curve vua tao
# @name readCreatedMapOverlayNT
# @no-log
POST {{apiBase}}/se-list/se-map/map-button/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

[
  {
    "z_request_median": "{{ntMapName}}",
    "project_id": "{{targetProjectId}}",
    "phase_id": "{{targetPhaseId}}",
    "se_parameter_id": "{{targetParameterId}}",
    "variation_id": "{{targetVariationId}}",
    "URL": "",
    "chosen_id": 1
  }
]

> {%
  const data = response.body?.data;
  const series = data?.overlay_series ?? [];
  const byKey = Object.fromEntries(series.map(item => [item.series_key, item]));

  client.test("Doc dung N-T Curve", function () {
    client.assert(response.status === 200, "Read khong tra HTTP 200");
    client.assert(data?.mode === "OVERLAY_1D", "mode khong dung");
    client.assert(data?.overlay_template === "N-T Curve", "overlay_template khong phai N-T Curve");
    client.assert(series.length === 4, "Phai co 4 goc phan tu");
    client.assert(
      JSON.stringify(byKey["第3象限"]?.t_values) === JSON.stringify([-120, -150, -100, 0]),
      "Du lieu goc phan tu 3 khong dung"
    );
    client.assert(byKey["第1象限"]?.direction === null, "Series tu do phai co direction null");
  });

  if (data?.xname) client.global.set("ntXName", data.xname);
  if (data?.tname) client.global.set("ntTName", data.tname);
%}

