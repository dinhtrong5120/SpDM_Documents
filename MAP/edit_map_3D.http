### 11. Xac nhan parameter da tro ve null
# @name verifyCleanup3D
# @no-log
POST {{apiBase}}/se-list/v2/list-se-list-parameters-new/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

[
  [
    {
      "projects_key": ["{{projectId}}"],
      "project": "{{projectName}}",
      "destination": "{{destination}}",
      "drivetrain": "{{drivetrain}}",
      "powertrain": "{{powertrain}}",
      "lot": "{{lot}}",
      "phase": "{{phaseName}}"
    }
  ]
]

> {%
  const groups = response.body?.projects?.[0]?.data ?? [];
  let finalValue;

  for (const group of groups) {
    for (const row of group.children ?? []) {
      if (String(row.se_parameter_id) !== String(client.global.get("targetParameterId"))) continue;

      for (const value of Object.values(row)) {
        if (
          value
          && typeof value === "object"
          && String(value.variation_id) === String(client.global.get("targetVariationId"))
        ) {
          finalValue = value.z_request_median;
          break;
        }
      }
    }
  }

  client.test("Cleanup hoan tat", function () {
    client.assert(
      finalValue === null,
      `Gia tri sau khi xoa la '${finalValue}', mong doi 'null'`
    );
  });

  client.log("Da xoa map " + client.global.get("demoMapName") + "; parameter tro ve " + finalValue);
%}
