### 9. Doc lai va doi chieu du lieu da sua
# @name readEditedMapOverlayOther
# @no-log
POST {{apiBase}}/se-list/se-map/map-button/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

[
  {
    "z_request_median": "{{otherMapName}}",
    "project_id": "{{targetProjectId}}",
    "phase_id": "{{targetPhaseId}}",
    "se_parameter_id": "{{targetParameterId}}",
    "variation_id": "{{targetVariationId}}",
    "URL": "",
    "chosen_id": 1
  }
]

> {%
  const series = response.body?.data?.overlay_series ?? [];
  const byKey = Object.fromEntries(series.map(item => [item.series_key, item]));

  client.test("Gia tri Other edit duoc luu", function () {
    client.assert(response.status === 200, "Read edited khong tra HTTP 200");
    client.assert(response.body?.data?.overlay_template === "その他", "overlay_template khong duoc giu nguyen");
    client.assert(
      JSON.stringify(byKey["系列_1"]?.t_values) === JSON.stringify([22, 27, 32, 37, 42]),
      "T cua series 1 sau edit khong dung"
    );
    client.assert(
      JSON.stringify(byKey["系列_2"]?.x_values) === JSON.stringify([0, 12.5, 25, 37.5]),
      "X cua series 2 sau edit khong dung"
    );
    client.assert(
      JSON.stringify(byKey["系列_2"]?.t_values) === JSON.stringify([-15, -5, 5, 15]),
      "T cua series 2 sau edit khong dung"
    );
  });
%}

