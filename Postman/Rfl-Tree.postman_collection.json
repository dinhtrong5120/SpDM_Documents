                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_name\": \"P33A\",\n  \"destination\": \"JPN\",\n  \"drivetrain\": \"2WD\",\n  \"powertrain\": \"HEV\",\n  \"lot\": \"L1\",\n  \"phase_name\": \"Phase1\",\n  \"hierarchy_id\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://127.0.0.1:8000/{{SUB_PATH}}/api/rfl-tree/list-work-packages",
              "protocol": "http",
              "host": [
                "127",
                "0",
                "0",
                "1"
              ],
              "port": "8000",
              "path": [
                "{{SUB_PATH}}",
                "api",
                "rfl-tree",
                "list-work-packages"
              ]
            },
            "description": "Phân giải metadata dự án (tên xe, đích đến, hệ dẫn động, powertrain, lot, phase) → trả về danh sách distinct work-package names (wp_names) cùng project_id, phase_id và hierarchy_id (3 = Unit, 2 = System, 1 = Vehicle)."
