  "se_parameter_id": "{{targetParameterId}}",
  "phase_id": "{{targetPhaseId}}",
  "variation_id": "{{targetVariationId}}",
  "action": "confirm_no_change"
}

> {%
  client.test("Bao thieu project_id", function () {
    client.assert(response.status === 400, `Mong doi 400, nhan ${response.status}`);
    client.assert(response.body?.missing_params?.includes("project_id"), "Response khong bao project_id");
  });
%}

