### 11. Xac nhan cleanup
# @name verifyCleanupOverlayNT
# @no-log
POST {{apiBase}}/se-list/v2/list-se-list-parameters-new/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

[
  [
    {
      "projects_key": ["{{projectId}}"],
      "project": "{{projectName}}",
      "destination": "{{destination}}",
      "drivetrain": "{{drivetrain}}",
      "body_type": "{{bodyType}}",
      "powertrain": "{{powertrain}}",
      "lot": "{{lot}}",
      "phase": "{{phaseName}}"
    }
  ]
]

> {%
  client.test("Doc lai SE sau cleanup thanh cong", function () {
    client.assert(response.status === 200, `API SE list tra HTTP ${response.status}`);
  });

  const groups = response.body?.projects?.[0]?.data ?? [];
  let finalValue;
  for (const group of groups) {
    for (const row of group.children ?? []) {
      if (String(row.se_parameter_id) !== String(client.global.get("targetParameterId"))) continue;
      for (const value of Object.values(row)) {
        if (value && typeof value === "object"
            && String(value.variation_id) === String(client.global.get("targetVariationId"))) {
          finalValue = value.z_request_median;
        }
      }
    }
  }

  client.test("Cleanup N-T hoan tat", function () {
    const clean = finalValue === null
      || ["N/A", "MAP"].includes(String(finalValue).trim().toUpperCase());
    client.assert(clean, `Gia tri sau cleanup la '${finalValue}'`);
  });
%}
