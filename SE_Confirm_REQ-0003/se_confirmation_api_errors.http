### 16. Request nhieu dong co mot target khong ton tai
# Dong dau khong gui field thay doi, nen ngay ca khi rollback hong cung khong sua du lieu.
### @name multiRowWithMissingTarget
# @no-log
POST {{apiBase}}/se-list/v1/update-se-list-value-new/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

[
  {
    "project_id": "{{targetProjectId}}",
    "se_parameter_id": "{{targetParameterId}}",
    "phase_id": "{{targetPhaseId}}",
    "variation_id": "{{targetVariationId}}"
  },
  {
    "project_id": {{missingId}},
    "se_parameter_id": {{missingId}},
    "phase_id": {{missingId}},
    "variation_id": {{missingId}}
  }
]

> {%
  client.test("Mot dong khong ton tai lam request that bai", function () {
    client.assert(response.status === 404, `Mong doi 404, nhan ${response.status}`);
    client.assert(response.body?.message === "SE item not found.", "Sai message");
  });
%}

### 17. History thieu cac query parameter bat buoc
### @name historyMissingParameters
# @no-log
GET {{apiBase}}/se-list/v1/parameter-history/?project_id={{targetProjectId}}
Authorization: Bearer {{access_token}}
Accept: application/json

> {%
  client.test("History bao du query parameter", function () {
    client.assert(response.status === 400, `Mong doi 400, nhan ${response.status}`);
    client.assert(response.body?.missing_params?.includes("se_parameter_id"), "Thieu se_parameter_id trong response");
    client.assert(response.body?.missing_params?.includes("phase_id"), "Thieu phase_id trong response");
  });
%}
