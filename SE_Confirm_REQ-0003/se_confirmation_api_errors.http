### UU3 SPDM - validation va loi API confirmation
#
# Coverage:
# - PM-06: chua dang nhap -> 401
# - API-01: thieu tung ID/action bat buoc -> 400
# - API-02: action khong hop le -> 400
# - API-03: dong khong ton tai -> 404
# - API-04: sai kieu request body -> 400
# - API-05: approval status khong phai so -> 400
# - ED-11: payload update trung khoa -> 400
# - ED-12: request nhieu dong co dong khong ton tai -> 404, khong update dong truoc
#
# Cac request trong file nay khong duoc phep thay doi du lieu.

@healthBase = {{devBaseUrl}}
@apiBase = {{devApiBase}}
@missingId = 2147483647

### 1. Confirmation khong co token
### @name confirmationWithoutToken
# @no-log
POST {{apiBase}}/se-list/v1/confirmation-status/
Content-Type: application/json
Accept: application/json

{
  "project_id": 1,
  "se_parameter_id": 1,
  "phase_id": 1,
  "variation_id": 1,
  "action": "confirm_no_change"
}

> {%
  client.test("Khong co token bi tu choi", function () {
    client.assert(response.status === 401, `Mong doi 401, nhan ${response.status}`);
  });
%}

### 2. Dang nhap
### @name loginConfirmationErrors
# @no-log
POST {{apiBase}}/user/login/
Content-Type: application/json
Accept: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

> {%
  client.test("Dang nhap thanh cong", function () {
    client.assert(response.status === 200, "Login khong tra HTTP 200");
    client.assert(Boolean(response.body?.access), "Khong co access token");
  });
  client.global.set("access_token", response.body.access);
%}

### 3. Chon project
### @name selectProjectConfirmationErrors
# @no-log
GET {{apiBase}}/project/all-projects/
Authorization: Bearer {{access_token}}
Accept: application/json

> {%
  const project = response.body?.data?.[0];
  client.test("Tim thay project", function () {
    client.assert(Boolean(project), "Khong co project tai data[0]");
  });
  if (project) {
    client.global.set("projectId", String(project.project_id));
    client.global.set("projectName", project.project_name);
    client.global.set("destination", project.destination);
    client.global.set("drivetrain", project.drivetrain);
    client.global.set("bodyType", project.grade);
    client.global.set("lot", project.lot);
    client.global.set("phaseName", project.phase_name);
  }
%}

### 4. Chon mot target that cho cac test validation sau lock
### @name selectConfirmationErrorTarget
# @no-log
POST {{apiBase}}/se-list/v2/list-se-list-parameters-new/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

[
  [
    {
      "projects_key": ["{{projectId}}"],
      "project": "{{projectName}}",
      "destination": "{{destination}}",
      "drivetrain": "{{drivetrain}}",
      "body_type": "{{bodyType}}",
      "lot": "{{lot}}",
      "phase": "{{phaseName}}"
    }
  ]
]

> {%
  const groups = response.body?.projects?.[0]?.data ?? [];
  let target = null;
  for (const group of groups) {
    for (const row of group.children ?? []) {
      for (const value of Object.values(row)) {
        if (value && typeof value === "object" && "variation_id" in value) {
          target = {
            projectId: row.project_id,
            parameterId: row.se_parameter_id,
            phaseId: row.phase_id,
            variationId: value.variation_id
          };
          break;
        }
      }
      if (target) break;
    }
    if (target) break;
  }
  client.test("Tim thay target", function () {
    client.assert(Boolean(target), "Project khong co o SE List de test");
  });
  if (target) {
    client.global.set("targetProjectId", String(target.projectId));
    client.global.set("targetParameterId", String(target.parameterId));
    client.global.set("targetPhaseId", String(target.phaseId));
    client.global.set("targetVariationId", String(target.variationId));
  }
%}

### 5. Confirmation body la array
### @name confirmationArrayBody
# @no-log
POST {{apiBase}}/se-list/v1/confirmation-status/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

[]

> {%
  client.test("Body array bi tu choi", function () {
    client.assert(response.status === 400, `Mong doi 400, nhan ${response.status}`);
    client.assert(response.body?.message === "Request body must be an object.", "Sai message");
  });
%}

### 6. Thieu project_id
