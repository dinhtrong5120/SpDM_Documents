### UU3 SPDM - xac nhan thu cong trang thai SE List
#
# Coverage:
# - CF-01/02/03/04/05: confirm mot dong va idempotency
# - RS-01/02/03/04: reset ve unconfirmed va idempotency
# - HS-01/02/05/06: lich su confirmation
# - MV-01/02: chi dung project/parameter/phase/variation da chon
#
# Chay tung request tu tren xuong duoi trong cung mot phien JetBrains HTTP Client.
# Environment dev can co: devBaseUrl, devApiBase, username, password.
# File CO GHI DU LIEU. Trang thai cuoi cua dong test la unconfirmed.

@healthBase = {{devBaseUrl}}
@apiBase = {{devApiBase}}

### 1. Kiem tra server
### @name healthConfirmationManual
# @no-log
GET {{healthBase}}/healthz
Accept: application/json

> {%
  client.test("Server san sang", function () {
    client.assert(response.status === 200, "Health check khong tra HTTP 200");
  });
%}

### 2. Dang nhap
### @name loginConfirmationManual
# @no-log
POST {{apiBase}}/user/login/
Content-Type: application/json
Accept: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

> {%
  client.test("Dang nhap thanh cong", function () {
    client.assert(response.status === 200, "Login khong tra HTTP 200");
    client.assert(Boolean(response.body?.access), "Response login khong co access token");
  });
  client.global.set("access_token", response.body.access);
%}

### 3. Chon project dau tien
# Neu project dau tien dang lock, doi [0] thanh project test khac.
### @name selectProjectConfirmationManual
# @no-log
GET {{apiBase}}/project/all-projects/
Authorization: Bearer {{access_token}}
Accept: application/json

> {%
  const project = response.body?.data?.[0];
  client.test("Tim thay project", function () {
    client.assert(Boolean(project), "Khong co project tai data[0]");
  });
  if (project) {
    client.global.set("projectId", String(project.project_id));
    client.global.set("projectName", project.project_name);
    client.global.set("destination", project.destination);
    client.global.set("drivetrain", project.drivetrain);
    client.global.set("bodyType", project.grade);
    client.global.set("lot", project.lot);
    client.global.set("phaseName", project.phase_name);
  }
%}

### 4. Chon mot o SE List de test
# Uu tien dong dang unconfirmed de cleanup khong lam thay doi trang thai cuoi.
### @name selectConfirmationTarget
# @no-log
POST {{apiBase}}/se-list/v2/list-se-list-parameters-new/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

[
  [
    {
      "projects_key": ["{{projectId}}"],
      "project": "{{projectName}}",
      "destination": "{{destination}}",
      "drivetrain": "{{drivetrain}}",
      "body_type": "{{bodyType}}",
      "lot": "{{lot}}",
      "phase": "{{phaseName}}"
    }
  ]
]

> {%
  const groups = response.body?.projects?.[0]?.data ?? [];
  let preferred = null;
  let fallback = null;
  for (const group of groups) {
    for (const row of group.children ?? []) {
      for (const [variationName, value] of Object.entries(row)) {
        if (!value || typeof value !== "object" || !("variation_id" in value)) continue;
        const candidate = {
          projectId: row.project_id,
          parameterId: row.se_parameter_id,
          phaseId: row.phase_id,
          variationId: value.variation_id,
          variationName,
          title: row.title_row,
          status: value.confirmation_status
        };
        fallback ??= candidate;
        if (value.confirmation_status === "unconfirmed") {
          preferred = candidate;
          break;
        }
      }
      if (preferred) break;
    }
    if (preferred) break;
  }
  const target = preferred ?? fallback;
  client.test("Tim thay o SE List", function () {
    client.assert(Boolean(target), "Project khong co o SE List de test");
  });
  if (target) {
    client.global.set("targetProjectId", String(target.projectId));
    client.global.set("targetParameterId", String(target.parameterId));
    client.global.set("targetPhaseId", String(target.phaseId));
    client.global.set("targetVariationId", String(target.variationId));
    client.global.set("initialConfirmationStatus", target.status ?? "NULL");
    client.log(`Target ${target.title}/${target.variationName}; status ban dau=${target.status ?? "NULL"}`);
  }
%}

### 5. Doc lich su ban dau
### @name historyBeforeManual
# @no-log
GET {{apiBase}}/se-list/v1/parameter-history/?project_id={{targetProjectId}}&se_parameter_id={{targetParameterId}}&phase_id={{targetPhaseId}}&variation_id={{targetVariationId}}
Authorization: Bearer {{access_token}}
Accept: application/json

> {%
  const history = response.body?.confirmation_history ?? [];
  client.test("Doc lich su thanh cong", function () {
    client.assert(response.status === 200, "History khong tra HTTP 200");
    client.assert(Array.isArray(history), "confirmation_history khong phai array");
  });
  client.global.set("manualHistoryBefore", String(history.length));
%}

### 6. Dua target ve unconfirmed de tao precondition
# Neu target da unconfirmed thi changed=false; neu chua thi changed=true.
### @name prepareUnconfirmed
# @no-log
POST {{apiBase}}/se-list/v1/confirmation-status/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{
  "project_id": "{{targetProjectId}}",
  "se_parameter_id": "{{targetParameterId}}",
  "phase_id": "{{targetPhaseId}}",
  "variation_id": "{{targetVariationId}}",
  "action": "reset_unconfirmed"
}

> {%
  client.test("Precondition unconfirmed thanh cong", function () {
    client.assert(response.status === 200, response.body?.message ?? "Reset that bai");
    client.assert(response.body?.confirmation_status === "unconfirmed", "Status khong phai unconfirmed");
  });
%}

### 7. Reset lai cung trang thai - khong tao thay doi trung lap
### @name resetUnconfirmedIdempotent
# @no-log
POST {{apiBase}}/se-list/v1/confirmation-status/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{
  "project_id": "{{targetProjectId}}",
  "se_parameter_id": "{{targetParameterId}}",
  "phase_id": "{{targetPhaseId}}",
  "variation_id": "{{targetVariationId}}",
  "action": "reset_unconfirmed"
}

> {%
  client.test("Reset lap lai la no-op", function () {
    client.assert(response.status === 200, "Reset lap lai khong tra HTTP 200");
    client.assert(response.body?.changed === false, "Reset lap lai phai changed=false");
  });
%}

### 8. Xac nhan khong thay doi
### @name confirmNoChange
# @no-log
POST {{apiBase}}/se-list/v1/confirmation-status/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{
  "project_id": "{{targetProjectId}}",
  "se_parameter_id": "{{targetParameterId}}",
  "phase_id": "{{targetPhaseId}}",
  "variation_id": "{{targetVariationId}}",
  "action": "confirm_no_change"
}

> {%
  client.test("Confirm no change thanh cong", function () {
    client.assert(response.status === 200, response.body?.message ?? "Confirm that bai");
    client.assert(response.body?.changed === true, "Lan confirm dau phai changed=true");
    client.assert(response.body?.confirmation_status === "confirmed_no_change", "Sai confirmation status");
  });
%}

### 9. Confirm lai - khong tao history trung lap
### @name confirmNoChangeIdempotent
# @no-log
POST {{apiBase}}/se-list/v1/confirmation-status/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{
  "project_id": "{{targetProjectId}}",
  "se_parameter_id": "{{targetParameterId}}",
  "phase_id": "{{targetPhaseId}}",
  "variation_id": "{{targetVariationId}}",
  "action": "confirm_no_change"
}

> {%
  client.test("Confirm lap lai la no-op", function () {
    client.assert(response.status === 200, "Confirm lap lai khong tra HTTP 200");
    client.assert(response.body?.changed === false, "Confirm lap lai phai changed=false");
  });
%}

### 10. Kiem tra history co su kien mark_confirmed
### @name historyAfterConfirm
# @no-log
GET {{apiBase}}/se-list/v1/parameter-history/?project_id={{targetProjectId}}&se_parameter_id={{targetParameterId}}&phase_id={{targetPhaseId}}&variation_id={{targetVariationId}}
Authorization: Bearer {{access_token}}
Accept: application/json

> {%
  const history = response.body?.confirmation_history ?? [];
  const first = history[0];
  client.test("History ghi nhan confirm", function () {
    client.assert(response.status === 200, "History khong tra HTTP 200");
    client.assert(first?.action === "mark_confirmed", "Su kien moi nhat khong phai mark_confirmed");
    client.assert(first?.new_status === "confirmed_no_change", "History ghi sai new_status");
    client.assert(first?.handling_type === "manual", "History ghi sai handling_type");
  });
%}

### 11. Reload SE List va xac nhan status duoc luu
### @name reloadAfterConfirm
# @no-log
POST {{apiBase}}/se-list/v2/list-se-list-parameters-new/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

[
  [
    {
      "projects_key": ["{{projectId}}"],
      "project": "{{projectName}}",
      "destination": "{{destination}}",
      "drivetrain": "{{drivetrain}}",
      "body_type": "{{bodyType}}",
      "lot": "{{lot}}",
      "phase": "{{phaseName}}"
    }
  ]
]

> {%
  const groups = response.body?.projects?.[0]?.data ?? [];
  let status = null;
  for (const group of groups) {
    for (const row of group.children ?? []) {
      if (String(row.se_parameter_id) !== String(client.global.get("targetParameterId"))) continue;
      for (const value of Object.values(row)) {
        if (value && typeof value === "object" && String(value.variation_id) === String(client.global.get("targetVariationId"))) {
          status = value.confirmation_status;
        }
      }
    }
  }
  client.test("Status ton tai sau reload", function () {
    client.assert(status === "confirmed_no_change", `Status sau reload=${status}`);
  });
%}

### 12. Cleanup: reset ve unconfirmed
### @name cleanupManualConfirmation
# @no-log
POST {{apiBase}}/se-list/v1/confirmation-status/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{
  "project_id": "{{targetProjectId}}",
  "se_parameter_id": "{{targetParameterId}}",
  "phase_id": "{{targetPhaseId}}",
  "variation_id": "{{targetVariationId}}",
  "action": "reset_unconfirmed"
}

> {%
  client.test("Cleanup thanh cong", function () {
    client.assert(response.status === 200, response.body?.message ?? "Cleanup that bai");
    client.assert(response.body?.changed === true, "Cleanup phai tao thay doi");
    client.assert(response.body?.confirmation_status === "unconfirmed", "Cleanup khong ve unconfirmed");
  });
%}

### 13. Kiem tra reset lap lai sau cleanup
### @name cleanupManualIdempotent
# @no-log
POST {{apiBase}}/se-list/v1/confirmation-status/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{
  "project_id": "{{targetProjectId}}",
  "se_parameter_id": "{{targetParameterId}}",
  "phase_id": "{{targetPhaseId}}",
  "variation_id": "{{targetVariationId}}",
  "action": "reset_unconfirmed"
}

> {%
  client.test("Cleanup lap lai khong tao history", function () {
    client.assert(response.status === 200, "Cleanup lap lai khong tra HTTP 200");
    client.assert(response.body?.changed === false, "Cleanup lap lai phai changed=false");
  });
%}
