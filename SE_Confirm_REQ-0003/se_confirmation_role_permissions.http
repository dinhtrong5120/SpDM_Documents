### 10. Work Package dung WP duoc confirm
# Neu policy cua position test khong co Value_Edit, request se 403 va can sua seed policy.
### @name correctWpCanConfirm
# @no-log
POST {{apiBase}}/se-list/v1/confirmation-status/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{
  "project_id": "{{targetProjectId}}",
  "se_parameter_id": "{{targetParameterId}}",
  "phase_id": "{{targetPhaseId}}",
  "variation_id": "{{targetVariationId}}",
  "action": "confirm_no_change"
}

> {%
  client.test("Dung WP duoc confirm", function () {
    client.assert(response.status === 200, response.body?.message ?? "Confirm that bai");
    client.assert(response.body?.confirmation_status === "confirmed_no_change", "Sai confirmation status");
  });
%}

### 11. Cleanup confirmation ve unconfirmed
### @name cleanupRolePermissionConfirmation
# @no-log
POST {{apiBase}}/se-list/v1/confirmation-status/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{
  "project_id": "{{targetProjectId}}",
  "se_parameter_id": "{{targetParameterId}}",
  "phase_id": "{{targetPhaseId}}",
  "variation_id": "{{targetVariationId}}",
  "action": "reset_unconfirmed"
}

> {%
  client.test("Cleanup confirmation thanh cong", function () {
    client.assert(response.status === 200, response.body?.message ?? "Cleanup that bai");
    client.assert(response.body?.confirmation_status === "unconfirmed", "Status cuoi khong phai unconfirmed");
  });
%}

### 12. RESTORE BAT BUOC: khoi phuc group/WP Admin ban dau
# Co the chay lai rieng request nay neu file bi dung giua chung.
### @name restoreOriginalAdminRole
# @no-log
POST {{apiBase}}/user/admin-change-user-info/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{
  "body": {
    "users": [
      {
        "username": "{{testUsername}}",
        "first_name": {{originalFirstNameJson}},
        "last_name": {{originalLastNameJson}},
        "email": {{originalEmailJson}},
        "department": {{originalDepartmentJson}},
        "groups": {{originalGroupsJson}},
        "work_package": {{originalWorkPackageJson}},
        "position": [{{originalPositionJson}}]
      }
    ]
  }
}

> {%
  client.test("Khoi phuc Admin thanh cong", function () {
    client.assert(response.status === 200, response.body?.message ?? "Restore Admin that bai");
    client.assert(response.body?.status === "success", response.body?.message ?? "Restore Admin that bai");
  });
%}

### 13. Xac minh group/WP da duoc restore
### @name verifyAdminRestored
# @no-log
GET {{apiBase}}/user/info/
Authorization: Bearer {{access_token}}
Accept: application/json

> {%
  const expectedGroups = JSON.parse(client.global.get("originalGroupsJson") || "[]").slice().sort();
  const actualGroups = (response.body?.data?.groups ?? []).slice().sort();
  const expectedWp = JSON.parse(client.global.get("originalWorkPackageJson") || "null");
  client.test("Admin da duoc restore", function () {
    client.assert(response.status === 200, "User info khong tra HTTP 200");
    client.assert(JSON.stringify(actualGroups) === JSON.stringify(expectedGroups), `Groups hien tai=${JSON.stringify(actualGroups)}`);
    client.assert(response.body?.data?.work_package === expectedWp, `WP hien tai=${response.body?.data?.work_package}`);
  });
%}
