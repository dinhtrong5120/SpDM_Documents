### 8. Dua confirmation ve unconfirmed truoc khi test change version
### @name prepareCubeUnconfirmed
# @no-log
POST {{apiBase}}/se-list/v1/confirmation-status/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{
  "project_id": "{{targetProjectId}}",
  "se_parameter_id": "{{targetParameterId}}",
  "phase_id": "{{targetPhaseId}}",
  "variation_id": "{{targetVariationId}}",
  "action": "reset_unconfirmed"
}

> {%
  client.test("Precondition unconfirmed", function () {
    client.assert(response.status === 200, response.body?.message ?? "Reset that bai");
    client.assert(response.body?.confirmation_status === "unconfirmed", "Status khong phai unconfirmed");
  });
%}

### 9. Doi version CUBE 002 -> 001 voi payload dung chieu
# Regression quan trong:
# - df_editeds = danh sach cac ma tran CUBE
# - df_edited_z = danh sach mot object Z
### @name changeCubeVersion
# @no-log
POST {{apiBase}}/se-list/se-map/map-edit/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{
  "chosen_id": 1,
  "mode": "CUBE",
  "project_id": "{{targetProjectId}}",
  "parameter_id": "{{targetParameterId}}",
  "scenario_parameter_id": "{{targetParameterId}}",
  "phase_id": "{{targetPhaseId}}",
  "variation_id": "{{targetVariationId}}",
  "map_name": "{{cubeMap002}}",
  "new_map_name": "{{cubeMap001}}",
  "scope_name": null,
  "xname": "{{xVariableName}}",
  "yname": "{{yVariableName}}",
  "zname": "{{zVariableName}}",
  "map_version": "001",
  "study_id": null,
  "vallist": [],
  "df_edited": null,
  "df_editeds": [
    [
      {"0": "↓Y \\ X→", "1": 1000, "2": 2000},
      {"0": 10, "1": 1311, "2": 1312},
      {"0": 20, "1": 1321, "2": 1322}
    ],
    [
      {"0": "↓Y \\ X→", "1": 1000, "2": 2000},
      {"0": 10, "1": 1611, "2": 1612},
      {"0": 20, "1": 1621, "2": 1622}
    ]
  ],
  "df_edited_z": [{"0": "Z→", "1": 300, "2": 600}],
  "map_variable_name": null,
  "cube_variable_name": "{{cubeVariableName}}",
  "tablenames": null,
  "add_new": null
}

> {%
  client.test("Doi version CUBE khong con loi scalar DataFrame", function () {
    client.assert(response.status === 200, response.body?.message ?? "Map edit that bai");
    client.assert(response.body?.status === "success", response.body?.message ?? "Map edit that bai");
  });
%}

### 10. Kiem tra SE List tro den version 001 va confirmed_changed
### @name verifyCubeVersionAndConfirmation
# @no-log
POST {{apiBase}}/se-list/v2/list-se-list-parameters-new/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

[
  [
    {
      "projects_key": ["{{projectId}}"],
      "project": "{{projectName}}",
      "destination": "{{destination}}",
      "drivetrain": "{{drivetrain}}",
      "body_type": "{{bodyType}}",
      "lot": "{{lot}}",
      "phase": "{{phaseName}}"
    }
  ]
]

> {%
  const groups = response.body?.projects?.[0]?.data ?? [];
  let target = null;
  for (const group of groups) {
    for (const row of group.children ?? []) {
      if (String(row.se_parameter_id) !== String(client.global.get("targetParameterId"))) continue;
      for (const value of Object.values(row)) {
        if (value && typeof value === "object" && String(value.variation_id) === String(client.global.get("targetVariationId"))) {
          target = value;
        }
      }
    }
  }
  client.test("Version va confirmation dung", function () {
    client.assert(Boolean(target), "Khong tim lai duoc target");
    client.assert(String(target?.z_request_median ?? "").includes("_Ver.001"), `Gia tri hien tai=${target?.z_request_median}`);
    client.assert(target?.confirmation_status === "confirmed_changed", `Status=${target?.confirmation_status}`);
  });
%}

### 11. Kiem tra map_save history
### @name verifyCubeMapHistory
# @no-log
GET {{apiBase}}/se-list/v1/parameter-history/?project_id={{targetProjectId}}&se_parameter_id={{targetParameterId}}&phase_id={{targetPhaseId}}&variation_id={{targetVariationId}}
Authorization: Bearer {{access_token}}
Accept: application/json

> {%
  const first = response.body?.confirmation_history?.[0];
  client.test("History ghi map_save", function () {
    client.assert(response.status === 200, "History khong tra HTTP 200");
    client.assert(first?.new_status === "confirmed_changed", "History sai new_status");
    client.assert(first?.handling_type === "map_save", `handling_type=${first?.handling_type}`);
  });
%}

