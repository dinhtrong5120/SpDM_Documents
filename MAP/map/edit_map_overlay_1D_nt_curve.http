### 9. Doc lai va doi chieu N-T Curve
# @name readEditedMapOverlayNT
# @no-log
POST {{apiBase}}/se-list/se-map/map-button/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

[
  {
    "z_request_median": "{{ntMapName}}",
    "project_id": "{{targetProjectId}}",
    "phase_id": "{{targetPhaseId}}",
    "se_parameter_id": "{{targetParameterId}}",
    "variation_id": "{{targetVariationId}}",
    "URL": "",
    "chosen_id": 1
  }
]

> {%
  const series = response.body?.data?.overlay_series ?? [];
  const byKey = Object.fromEntries(series.map(item => [item.series_key, item]));

  client.test("Gia tri N-T edit duoc luu", function () {
    client.assert(response.status === 200, "Read edited khong tra HTTP 200");
    client.assert(response.body?.data?.overlay_template === "N-T Curve", "overlay_template khong duoc giu nguyen");
    client.assert(
      JSON.stringify(byKey["第1象限"]?.t_values) === JSON.stringify([0, 110, 160, 130]),
      "Gia tri goc phan tu 1 sau edit khong dung"
    );
    client.assert(
      JSON.stringify(byKey["第4象限"]?.t_values) === JSON.stringify([0, -110, -160, -130]),
      "Gia tri goc phan tu 4 sau edit khong dung"
    );
  });
%}

