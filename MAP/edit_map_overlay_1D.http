### UU3 SPDM - demo vong doi Map OVERLAY_1D
#
# OVERLAY_1D duoc luu bang dung hai dong map_structure:
# - 1 bien axis = X
# - 1 bien axis = OVERLAY_1D (truc T)
#
# Moi value co dang:
#   series_key:value1,value2;series_key:value1,value2
#
# Chay tung request tu tren xuong duoi trong cung mot phien PyCharm.
# Chon Run with -> dev. Environment dev can co:
#   devBaseUrl, devApiBase, username, password
#
# Luong: login -> chon parameter rong -> chon/tao bien X-T -> tao -> doc va
# doi chieu -> sua -> doc va doi chieu -> xoa -> cleanup.
#
# Luu y:
# - Day la demo CO GHI DU LIEU tren moi truong dang chon.
# - Neu chua co map_variable axis OVERLAY_1D, request create se tao bien
#   HTTP_DEMO_OVERLAY_T_deg. API xoa MAP khong xoa master map_variable nay;
#   cac lan chay sau se tai su dung no.

@healthBase = {{devBaseUrl}}
@apiBase = {{devApiBase}}
@scopeName = System_Control

### 1. Kiem tra server
# @name healthOverlay1D
# @no-log
GET {{healthBase}}/healthz
Accept: application/json

#> {%
#  client.test("Server san sang", function () {
#    client.assert(response.status === 200, "Health check khong tra HTTP 200");
#  });
#%}

### 2. Dang nhap va tao ten Map OVERLAY_1D duy nhat
# @name loginOverlay1D
# @no-log
POST {{apiBase}}/user/login/
Content-Type: application/json
Accept: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

> {%
  client.test("Dang nhap thanh cong", function () {
    client.assert(response.status === 200, "Login khong tra HTTP 200");
    client.assert(Boolean(response.body?.access), "Response login khong co access token");
  });

  if (response.body?.access) {
    const timestamp = new Date().toISOString().replace(/\D/g, "").slice(0, 14);
    const demoMapName = `HTTP_DEMO_OVERLAY_1D_${timestamp}_001`;

    client.global.set("access_token", response.body.access);
    client.global.set("refresh_token", response.body.refresh);
    client.global.set("demoMapName", demoMapName);
    client.log("Map demo cua lan chay nay: " + demoMapName);
  }
%}

### 3. Lay project dau tien va luu metadata
# Neu muon dung project khac, sua [0] trong response handler.
# @name selectProjectOverlay1D
# @no-log
GET {{apiBase}}/project/all-projects/
Authorization: Bearer {{access_token}}
Accept: application/json

> {%
  const project = response.body?.data?.[0];

  client.test("Tim thay project", function () {
    client.assert(Boolean(project), "Khong co project tai data[0]");
  });

  if (project) {
    client.global.set("projectId", String(project.project_id));
    client.global.set("projectName", project.project_name);
    client.global.set("phaseName", project.phase_name);
    client.global.set("destination", project.destination);
    client.global.set("drivetrain", project.drivetrain);
    client.global.set("powertrain", project.powertrain);
    client.global.set("lot", project.lot);
    client.log(`Da chon project ${project.project_name}, phase ${project.phase_name}`);
  }
%}

### 4. Chon mot SE parameter dang N/A hoac rong
# Script co y khong ghi de parameter dang co du lieu.
# Neu khong tim thay candidate, chon project khac o request 3.
# @name selectEmptyParameterOverlay1D
# @no-log
POST {{apiBase}}/se-list/v2/list-se-list-parameters-new/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

[
  [
    {
      "projects_key": ["{{projectId}}"],
      "project": "{{projectName}}",
      "destination": "{{destination}}",
      "drivetrain": "{{drivetrain}}",
      "powertrain": "{{powertrain}}",
      "lot": "{{lot}}",
      "phase": "{{phaseName}}"
    }
  ]
]

> {%
  const groups = response.body?.projects?.[0]?.data ?? [];
  let selected = null;

  for (const group of groups) {
    for (const row of group.children ?? []) {
      for (const [variationName, value] of Object.entries(row)) {
        if (!value || typeof value !== "object" || !("variation_id" in value)) {
          continue;
        }

        const currentValue = value.z_request_median;
        const isEmpty = currentValue === null
          || currentValue === undefined
          || String(currentValue).trim() === ""
          || String(currentValue).trim().toUpperCase() === "N/A";

        if (isEmpty) {
          selected = {
            projectId: row.project_id,
            parameterId: row.se_parameter_id,
            phaseId: row.phase_id,
            variationId: value.variation_id,
            variationName,
            title: row.title_row
          };
          break;
        }
      }
      if (selected) break;
    }
    if (selected) break;
  }

  client.test("Tim thay parameter an toan cho demo", function () {
    client.assert(
      Boolean(selected),
      "Khong co SE parameter N/A/rong. Hay chon project khac; khong nen ghi de du lieu dang co."
    );
  });

  if (selected) {
    client.global.set("targetProjectId", String(selected.projectId));
    client.global.set("targetParameterId", String(selected.parameterId));
    client.global.set("targetPhaseId", String(selected.phaseId));
    client.global.set("targetVariationId", String(selected.variationId));
    client.global.set("targetVariationName", selected.variationName);
    client.log(
      `Da chon parameter ${selected.parameterId} (${selected.title}), variation ${selected.variationName}`
    );
  }
%}

### 5. Chon bien X va T; tao T neu database chua co
# overlayAddNewJson duoc chen truc tiep vao JSON cua request create.
# @name selectMapVariablesOverlay1D
# @no-log
POST {{apiBase}}/se-list/se-map/get-infomation/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{}

> {%
  const overlayInfo = response.body?.data?.OVERLAY_1D;
  const xVariable = overlayInfo?.["X軸名"]?.[0];
  const tVariable = overlayInfo?.["T軸名"]?.[0];

  client.test("Tim thay bien X va metadata OVERLAY_1D", function () {
    client.assert(Boolean(overlayInfo), "Response khong co mode OVERLAY_1D");
    client.assert(Boolean(xVariable), "Khong co map_variable axis X");
    client.assert(
      overlayInfo?.max_points_per_series === 20,
      "max_points_per_series khong bang 20"
    );
  });

  if (xVariable) {
    client.global.set("xVariableName", xVariable);
    client.log("Bien X: " + xVariable);
  }

  if (tVariable) {
    client.global.set("tVariableName", tVariable);
    client.global.set("overlayAddNewJson", "{}");
    client.log("Tai su dung bien T: " + tVariable);
  } else {
    client.global.set("tVariableName", "");
    client.global.set("overlayAddNewJson", JSON.stringify({
      tname: {
        variable_name: "HTTP_DEMO_OVERLAY_T",
        unit: "deg"
      }
    }));
    client.log("Chua co bien T; request create se tao HTTP_DEMO_OVERLAY_T_deg");
  }
%}

### 6. Tao Map OVERLAY_1D voi hai series co so diem khac nhau
# UP_1-2 co 7 cap X/T; DOWN_2-1 co 4 cap X/T.
# @name createMapOverlay1D
# @no-log
POST {{apiBase}}/se-list/se-map/map-create/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{
  "chosen_id": 1,
  "mode": "OVERLAY_1D",
  "df_edited": null,
  "df_editeds": null,
  "df_edited_z": null,
  "map_name": "N/A",
  "new_map_name": "{{demoMapName}}",
  "xname": "{{xVariableName}}",
  "tname": "{{tVariableName}}",
  "overlay_series": [
    {
      "series_key": "UP_1-2",
      "x_values": [12.648, 12.648, 14.5, 23, 30, 48, 48],
      "t_values": [0, 18, 20, 30, 40, 70, 80]
    },
    {
      "series_key": "DOWN_2-1",
      "x_values": [0.25, 0.25, 16.497, 16.497],
      "t_values": [0, 70, 70.001, 80]
    }
  ],
  "yname": null,
  "zname": null,
  "cube_variable_name": null,
  "map_variable_name": null,
  "tablenames": null,
  "project_id": "{{targetProjectId}}",
  "parameter_id": "{{targetParameterId}}",
  "phase_id": "{{targetPhaseId}}",
  "variation_id": "{{targetVariationId}}",
  "study_id": null,
  "scope_name": "{{scopeName}}",
  "add_new": {{overlayAddNewJson}},
  "username": "{{username}}",
  "create_new_map_flg": true
}

> {%
  client.test("Tao Map OVERLAY_1D thanh cong", function () {
    client.assert(response.status === 200, "Create map khong tra HTTP 200");
    client.assert(response.body?.status === "success", response.body?.message ?? "Create map that bai");
  });
%}

### 7. Doc va doi chieu Map OVERLAY_1D vua tao
# @name readCreatedMapOverlay1D
# @no-log
POST {{apiBase}}/se-list/se-map/map-button/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

[
  {
    "z_request_median": "{{demoMapName}}",
    "project_id": "{{targetProjectId}}",
    "phase_id": "{{targetPhaseId}}",
    "se_parameter_id": "{{targetParameterId}}",
    "variation_id": "{{targetVariationId}}",
    "URL": "",
    "chosen_id": 1
  }
]

> {%
  const data = response.body?.data;
  const series = data?.overlay_series ?? [];
  const byKey = Object.fromEntries(series.map(item => [item.series_key, item]));

  client.test("Doc dung contract OVERLAY_1D", function () {
    client.assert(response.status === 200, "Read map khong tra HTTP 200");
    client.assert(response.body?.status === "success", response.body?.message ?? "Read map that bai");
    client.assert(data?.mode === "OVERLAY_1D", "mode khong phai OVERLAY_1D");
    client.assert(Boolean(data?.xname), "Response khong co xname");
    client.assert(Boolean(data?.tname), "Response khong co tname");
    client.assert(data?.df_display === null, "df_display phai la null");
    client.assert(series.length === 2, "overlay_series phai co 2 series");
  });

  client.test("Du lieu create duoc round-trip chinh xac", function () {
    client.assert(
      JSON.stringify(byKey["UP_1-2"]?.x_values) === JSON.stringify([12.648, 12.648, 14.5, 23, 30, 48, 48]),
      "X cua UP_1-2 khong dung"
    );
    client.assert(
      JSON.stringify(byKey["UP_1-2"]?.t_values) === JSON.stringify([0, 18, 20, 30, 40, 70, 80]),
      "T cua UP_1-2 khong dung"
    );
    client.assert(byKey["UP_1-2"]?.direction === "UP", "direction cua UP_1-2 khong dung");
    client.assert(byKey["UP_1-2"]?.from_no === 1, "from_no cua UP_1-2 khong dung");
    client.assert(byKey["UP_1-2"]?.to_no === 2, "to_no cua UP_1-2 khong dung");
    client.assert(
      JSON.stringify(byKey["DOWN_2-1"]?.x_values) === JSON.stringify([0.25, 0.25, 16.497, 16.497]),
      "X cua DOWN_2-1 khong dung"
    );
    client.assert(
      JSON.stringify(byKey["DOWN_2-1"]?.t_values) === JSON.stringify([0, 70, 70.001, 80]),
      "T cua DOWN_2-1 khong dung"
    );
  });

  if (data?.tname) {
    client.global.set("tVariableName", data.tname);
    client.log("Bien T thuc te cua map: " + data.tname);
  }
%}

