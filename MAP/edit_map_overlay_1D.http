### 9. Doc lai va doi chieu Map OVERLAY_1D sau khi sua
# @name readEditedMapOverlay1D
# @no-log
POST {{apiBase}}/se-list/se-map/map-button/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

[
  {
    "z_request_median": "{{demoMapName}}",
    "project_id": "{{targetProjectId}}",
    "phase_id": "{{targetPhaseId}}",
    "se_parameter_id": "{{targetParameterId}}",
    "variation_id": "{{targetVariationId}}",
    "URL": "",
    "chosen_id": 1
  }
]

> {%
  const data = response.body?.data;
  const series = data?.overlay_series ?? [];
  const byKey = Object.fromEntries(series.map(item => [item.series_key, item]));

  client.test("Doc lai Map OVERLAY_1D thanh cong", function () {
    client.assert(response.status === 200, "Read edited map khong tra HTTP 200");
    client.assert(response.body?.status === "success", response.body?.message ?? "Read edited map that bai");
    client.assert(data?.mode === "OVERLAY_1D", "mode sau edit khong dung");
  });

  client.test("Du lieu edit duoc luu chinh xac", function () {
    client.assert(
      JSON.stringify(byKey["UP_1-2"]?.t_values) === JSON.stringify([0, 20, 25, 35, 45, 75, 85]),
      "T cua UP_1-2 sau edit khong dung"
    );
    client.assert(
      JSON.stringify(byKey["DOWN_2-1"]?.x_values) === JSON.stringify([0.5, 0.5, 17, 17]),
      "X cua DOWN_2-1 sau edit khong dung"
    );
    client.assert(
      JSON.stringify(byKey["DOWN_2-1"]?.t_values) === JSON.stringify([0, 65, 72, 80]),
      "T cua DOWN_2-1 sau edit khong dung"
    );
  });
%}

### 10. Xoa toan bo Map OVERLAY_1D demo
# scope = all xoa map_structure/detail history cua ten map demo duy nhat,
# dong thoi dua project_parameter da chon ve N/A/null.
# @name deleteMapOverlay1D
# @no-log
POST {{apiBase}}/se-list/se-map/map-delete/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{
  "scope": "all",
  "project_id": "{{targetProjectId}}",
  "se_parameter_id": "{{targetParameterId}}",
  "phase_id": "{{targetPhaseId}}",
  "variation_id": "{{targetVariationId}}",
  "z_request_median": "{{demoMapName}}"
}

> {%
  client.test("Xoa Map OVERLAY_1D thanh cong", function () {
    client.assert(response.status === 200, "Delete map khong tra HTTP 200");
    client.assert(response.body?.status === "success", response.body?.message ?? "Delete map that bai");
  });
%}

### 11. Xac nhan parameter da tro ve null
# @name verifyCleanupOverlay1D
# @no-log
POST {{apiBase}}/se-list/v2/list-se-list-parameters-new/
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

[
  [
    {
      "projects_key": ["{{projectId}}"],
      "project": "{{projectName}}",
      "destination": "{{destination}}",
      "drivetrain": "{{drivetrain}}",
      "powertrain": "{{powertrain}}",
      "lot": "{{lot}}",
      "phase": "{{phaseName}}"
    }
  ]
]

> {%
  const groups = response.body?.projects?.[0]?.data ?? [];
  let finalValue;

  for (const group of groups) {
    for (const row of group.children ?? []) {
      if (String(row.se_parameter_id) !== String(client.global.get("targetParameterId"))) {
        continue;
      }

      for (const value of Object.values(row)) {
        if (
          value
          && typeof value === "object"
          && String(value.variation_id) === String(client.global.get("targetVariationId"))
        ) {
          finalValue = value.z_request_median;
          break;
        }
      }
    }
  }

  client.test("Cleanup hoan tat", function () {
    const isClean = finalValue === null
      || String(finalValue).trim().toUpperCase() === "N/A";
    client.assert(
      isClean,
      `Gia tri sau khi xoa la '${finalValue}', mong doi null hoac N/A`
    );
  });

  client.log("Da xoa map " + client.global.get("demoMapName") + "; parameter tro ve " + finalValue);
%}
