  "df_edited_z": null,
  "map_name": "{{demoMapName}}",
  "new_map_name": "{{demoMapName}}",
  "xname": "{{xVariableName}}",
  "yname": null,
  "zname": null,
  "cube_variable_name": null,
  "map_variable_name": null,
  "tablenames": ["{{tableVariableName}}"],
  "project_id": "{{targetProjectId}}",
  "parameter_id": "{{targetParameterId}}",
  "phase_id": "{{targetPhaseId}}",
  "variation_id": "{{targetVariationId}}",
  "study_id": null,
  "scope_name": "{{scopeName}}",
  "add_new": {},
  "username": "{{username}}",
  "create_new_map_flg": false
}

> {%
  client.test("Sua Map 1D thanh cong", function () {
    client.assert(response.status === 200, "Edit map khong tra HTTP 200");
    client.assert(response.body?.status === "success", response.body?.message ?? "Edit map that bai");
  });
%}

